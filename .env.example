# Midtrans Configuration
# Get your keys from https://dashboard.midtrans.com/settings/config_info

# For Sandbox (Testing)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_sandbox_client_key_here
MIDTRANS_SERVER_KEY=your_sandbox_server_key_here

# For Production
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_production_client_key_here
# MIDTRANS_SERVER_KEY=your_production_server_key_here

# Set to 'production' when going live
MIDTRANS_ENVIRONMENT=sandbox
